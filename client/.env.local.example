# ---------- Go server (only needed when running without docker-compose) ----------
SERVER_ID=server-1
REDIS_URL=localhost:6379
PORT=8080

# ---------- Client: copy to client/.env.local ----------
# WebSocket endpoint. Local Go server: ws://localhost:8080/ws   |  docker-compose (via nginx): ws://localhost/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Optional TURN server so video connects through strict NATs / mobile data.
# Comma-separate several URLs if needed.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Optional Google login (shows a "Google login" button and uses your Google avatar)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=change-me
# NEXT_PUBLIC_GOOGLE_ENABLED=true
